{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(just)",
      "Bash(just --list)",
      "Bash(just check)",
      "Bash(just check-fast)",
      "Bash(just lint)",
      "Bash(just fmt)",
      "Bash(just test)",
      "Bash(just gen)",
      "Bash(just gen --check)",
      "Bash(just gen --list)",
      "Bash(just validate)",
      "Bash(just skills-check)",
      "Bash(just harness-check)",
      "Bash(just harness-md-lint)",
      "Bash(just harness-md-lint *)",
      "Bash(just fixtures-check)",
      "Bash(just hub-check)",
      "Bash(just spec-check)",
      "Bash(just spec-archived)",
      "Bash(just pr-labels *)",
      "Bash(just secrets)",
      "Bash(just secrets-commits *)",
      "Bash(just publish-check *)",
      "Bash(just site-check)",
      "Bash(just site-build)",
      "Bash(just client-footprint *)",
      "Bash(just versions)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git clean -*f*)",
      "Bash(git clean * -*f*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -fr .)",
      "Bash(rm -fr ./)",
      "Bash(rm -fr /)",
      "Bash(rm -fr ~)"
    ]
  }
}
