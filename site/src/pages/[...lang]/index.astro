---
import HubSearch from "../../components/HubSearch.astro";
import { SECTIONS, ui } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import { hubEntries } from "../../lib/hub";
import { href, type Lang, langPaths } from "../../lib/paths";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const entries = await hubEntries();
---

<Base lang={lang} path="/">
  <div class="wrap">
    <section class="finder">
      <h1>{t.home.heading}</h1>
      <HubSearch lang={lang} entries={entries} size="large" limit={5} />
      {
        entries.length > 0 && (
          <p class="browse">
            <a href={href("/hub/", lang)}>{t.search.browseAll(entries.length)}</a>
          </p>
        )
      }
    </section>

    <div class="about">
      <section class="what">
        <h2>{t.home.whatHeading}</h2>
        {t.home.what.map((paragraph) => <p set:html={paragraph} />)}

        <h2 class="next-heading">{t.home.nextHeading}</h2>
        <ul class="next">
          {
            t.home.next.map((item) => (
              <li>
                <a href={href(item.path, lang)}>{item.label}</a>
                <span>{item.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="skeleton" aria-labelledby="skeleton-heading">
        <h2 id="skeleton-heading">{t.home.skeletonHeading}</h2>
        <p class="skeleton-lead">{t.home.skeletonLead}</p>
        <ol>
          {
            SECTIONS.map((section, index) => (
              <li class={section.required ? "required" : "optional"}>
                <span class="heading" lang="en">
                  <span class="marks" aria-hidden="true">
                    ##
                  </span>{" "}
                  {section.name}
                </span>
                <span class="question">{t.home.questions[index]}</span>
                <span class="need">{section.required ? t.home.required : t.home.optional}</span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</Base>

<style>
  .finder {
    max-width: 46rem;
    padding-block: clamp(3rem, 9vh, 6rem) 1rem;
  }

  .finder h1 {
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 2.75rem);
    letter-spacing: -0.015em;
    margin-bottom: 1.5rem;
  }

  .browse {
    margin-top: 1.25rem;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--rule);
  }

  h2 {
    font-size: 1.375rem;
  }

  .what p {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 38rem;
  }

  .what :global(code) {
    background: var(--wash);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .skeleton-lead {
    margin-top: 1rem;
    color: var(--muted);
  }

  .skeleton ol {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  /* One line of the outline: the heading as it is written in the file, the
     question it answers, and whether the format requires it. */
  .skeleton li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .skeleton .heading {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .skeleton .marks {
    color: var(--accent);
  }

  .skeleton .need {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.8125rem;
    color: var(--muted);
    align-self: center;
  }

  .skeleton .question {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .skeleton .optional .heading,
  .skeleton .optional .marks {
    color: var(--muted);
    font-weight: 400;
  }

  .skeleton .required .need {
    color: var(--ink);
    font-weight: 500;
  }

  .next-heading {
    margin-top: 3rem;
  }

  .next {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    max-width: 38rem;
    border-top: 1px solid var(--rule);
  }

  .next li {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--rule);
  }

  .next a {
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .next span {
    display: block;
    margin-top: 0.125rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
    }
  }
</style>
