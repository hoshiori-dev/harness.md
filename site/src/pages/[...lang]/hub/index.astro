---
import HubSearch from "../../../components/HubSearch.astro";
import { ui } from "../../../i18n/ui";
import Base from "../../../layouts/Base.astro";
import { hubEntries } from "../../../lib/hub";
import { type Lang, langPaths, REPO_URL } from "../../../lib/paths";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const entries = await hubEntries();
---

<Base lang={lang} path="/hub/" title={t.hub.title} description={t.hub.lead} section="hub">
  <div class="wrap">
    <header class="page-head">
      <h1>{t.hub.title}</h1>
      <p class="lead">{t.hub.lead}</p>
    </header>
    <HubSearch lang={lang} entries={entries} showTags />
    <p class="contribute">
      {t.hub.contribute}{lang === "en" ? " " : ""}<a href={`${REPO_URL}/tree/main/hub`}>{t.hub.contributeLink}</a>{lang === "zh" ? "。" : "."}
    </p>
  </div>
</Base>

<style>
  .contribute {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
