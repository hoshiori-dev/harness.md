---
import { getEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import AsideNav from "../../components/AsideNav.astro";
import PageActions from "../../components/PageActions.astro";
import { ui } from "../../i18n/ui";
import Base from "../../layouts/Base.astro";
import { prepare } from "../../lib/markdown";
import { specFile } from "../../lib/pagemd";
import { href, LANGS, type Lang, langPaths, markdownPath, REPO_URL } from "../../lib/paths";
import { specBytes } from "../../lib/spec";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const entry = await getEntry("spec", lang);
if (!entry?.rendered) {
  throw new Error(`${specFile(lang)} is missing; the site renders it at build time`);
}

// The specification files link to each other by file name; on the site that
// is the same page in the other language.
const translations = Object.fromEntries(LANGS.map((code) => [specFile(code).replace("spec/", ""), href("/spec/", code)]));
const html = prepare(entry.rendered.html, "spec", translations);
const source = new TextDecoder().decode(await specBytes(lang));
const headings = ((entry.rendered.metadata?.headings ?? []) as MarkdownHeading[]).filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<Base lang={lang} path="/spec/" title={t.spec.title} description={t.spec.description} section="spec">
  <div class="wrap with-aside">
    <AsideNav
      title={t.spec.toc}
      label={t.spec.toc}
      items={headings.map((heading) => ({ href: `#${heading.slug}`, label: heading.text, depth: heading.depth }))}
    />
    <div>
      <div class="page-tools">
        <PageActions
          lang={lang}
          markdown={source}
          markdownHref={href(markdownPath("/spec/"), lang)}
          github={{ href: `${REPO_URL}/blob/main/${specFile(lang)}`, kind: "source" }}
        />
      </div>
      <article class="prose" data-pagefind-body data-pagefind-filter="type:spec" set:html={html} />
    </div>
  </div>
</Base>
